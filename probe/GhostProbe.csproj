<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework><LangVersion>latest</LangVersion><AssemblyName>GhostFlightProbe</AssemblyName>
    <NuGetAudit>false</NuGetAudit><RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <GameDir Condition="'$(GameDir)'==''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
    <ReplayModPath Condition="'$(ReplayModPath)'==''">../src/bin/Release/net472/ReplayMod.dll</ReplayModPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameDir)/NuclearOption_Data/Managed/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameDir)/NuclearOption_Data/Managed/UnityEngine.UI.dll" Private="false" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp" PublicizeTarget="All" PublicizeCompilerGenerated="true" IncludeOriginalAttributesAttribute="false" Strip="false" />
    <Reference Include="ReplayMod" HintPath="$(ReplayModPath)" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameDir)/NuclearOption_Data/Managed/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UniTask" HintPath="$(GameDir)/NuclearOption_Data/Managed/UniTask.dll" Private="false" />
    <Reference Include="Mirage" HintPath="$(GameDir)/NuclearOption_Data/Managed/Mirage.dll" Private="false" />
    <Reference Include="Mirage.SocketLayer" HintPath="$(GameDir)/NuclearOption_Data/Managed/Mirage.SocketLayer.dll" Private="false" />
    <Reference Include="Mirage.Sockets.Udp" HintPath="$(GameDir)/NuclearOption_Data/Managed/Mirage.Sockets.Udp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameDir)/NuclearOption_Data/Managed/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameDir)/NuclearOption_Data/Managed/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GameDir)/NuclearOption_Data/Managed/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(GameDir)/NuclearOption_Data/Managed/UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GameDir)/NuclearOption_Data/Managed/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(GameDir)/NuclearOption_Data/Managed/UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(GameDir)/NuclearOption_Data/Managed/UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameDir)/NuclearOption_Data/Managed/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
  </ItemGroup>
</Project>


